// CI build of the archetype: build, package and run the integration tests that generate both project
// variants (includeWebServer=Y/N) and run `mvn verify` on them.
//
// Deliberately does NOT deploy: no `deploy` goal and no `-Pdeployment` profile (sources/javadoc jars,
// GPG signing and the Maven Central upload are handled separately).
//
// Job: "Pipeline script from SCM" (NOT an inline "Pipeline script": an inline script replaces this file
// and the build finishes SUCCESS without running any stage). Git, repository
// https://nginx-proxy/forgejo/koziolek/presentation-basic-archetype.git, credentials 'forgejo-jenkins'
// (Forgejo token), branch */master, Script Path: Jenkinsfile.
// Trigger: webhook from Forgejo. The first stage checks out origin again for the full workspace.
//
// Requirements: JDK 27, Maven and mvnd come from SDKMAN on the Jenkins host; versions match
// `java=`, `maven=` and `mvnd=` in .sdkmanrc. The build itself runs plain `mvn` (the integration
// tests need JDK 27); mvnd is only put on the PATH.
pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '5'))
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        // The checkout is done explicitly (and first) in the "Checkout" stage below.
        skipDefaultCheckout(true)
    }

    environment {
        JAVA_HOME = '/var/jenkins_home/sdkman/candidates/java/27.0.1.1-open'
        MAVEN_HOME = '/var/jenkins_home/sdkman/candidates/maven/3.10.2'
        MVND_HOME = '/var/jenkins_home/sdkman/candidates/mvnd/1.0.6'
        PATH = "${JAVA_HOME}/bin:${MAVEN_HOME}/bin:${MVND_HOME}/bin:${env.PATH}"
        MAVEN_ARGS = '-B -ntp'
        // origin on Forgejo, reached over HTTPS through nginx-proxy (same access as the blog job).
        FORGEJO_URL = 'https://nginx-proxy/forgejo/koziolek/presentation-basic-archetype.git'
        FORGEJO_CREDENTIALS_ID = 'forgejo-jenkins'
        GIT_SSL_NO_VERIFY = 'true' // untrusted internal certificates
    }

    stages {
        stage('Checkout') {
            steps {
                // BRANCH_NAME is set by multibranch jobs; a plain pipeline job builds master.
                checkout([
                        $class: 'GitSCM',
                        branches: [[name: "*/${env.BRANCH_NAME ?: 'master'}"]],
                        userRemoteConfigs: [[url: env.FORGEJO_URL, credentialsId: env.FORGEJO_CREDENTIALS_ID]]
                ])
                sh 'git log -1 --oneline'
            }
        }

        stage('Versions') {
            steps {
                sh 'test -x "$JAVA_HOME/bin/java"'
                sh 'test -x "$MAVEN_HOME/bin/mvn"'
                sh 'test -x "$MVND_HOME/bin/mvnd"'
                sh 'java -version'
                sh 'mvn -version'
            }
        }

        stage('Build and test') {
            steps {
                // `verify`, never `deploy`; the integration tests run in the integration-test phase.
                sh 'mvn clean verify'
            }
            post {
                always {
                    // Surefire reports of the projects generated by the integration tests.
                    junit testResults: 'target/test-classes/projects/**/target/surefire-reports/*.xml',
                            allowEmptyResults: true
                }
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'target/presentation-basic-archetype-*.jar', fingerprint: true
        }
        cleanup {
            deleteDir()
        }
    }
}
